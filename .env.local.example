GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyxxxxx

# --- Trigger.dev ---
# Get from https://cloud.trigger.dev → your project → API keys (server)
TRIGGER_SECRET_KEY=tr_dev_xxxxx
TRIGGER_PROJECT_REF=proj_xxxxx

# --- Transloadit (FFmpeg image cropping) ---
